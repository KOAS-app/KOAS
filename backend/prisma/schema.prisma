generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  OWNER
  ADMIN
}

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  password         String
  role             Role
  phoneNumber      String?   // Phone number for contact (required for players)
  isApproved       Boolean   @default(false)
  subscriptionPlan String    @default("STARTER") // STARTER, PRO, ELITE
  createdAt        DateTime  @default(now())

  stadiums  Stadium[]
  bookings  Booking[]
  reviews   Review[]
  subscriptions PlayerSubscription[]
}

model Stadium {
  id                String    @id @default(uuid())
  name              String
  locations         String[]  // Array of branch locations
  description       String?
  imageUrl          String?   // Main stadium image
  amenities         String[]  @default([]) // Stadium amenities/features
  ownerId           String    @unique // One stadium per owner
  isApproved        Boolean   @default(false)
  createdAt         DateTime  @default(now())

  owner         User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  slots         Slot[]
  reviews       Review[]
  bankAccounts  BankAccount[]
  subscriptionPlans SubscriptionPlan[]
}

model BankAccount {
  id                String    @id @default(uuid())
  stadiumId         String
  bankName          String    // e.g., "Commercial Bank of Ethiopia"
  accountNumber     String    // Bank account number
  accountHolderName String    // Name on the bank account
  isDefault         Boolean   @default(false) // One default account per stadium
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  stadium           Stadium   @relation(fields: [stadiumId], references: [id], onDelete: Cascade)

  @@index([stadiumId])
}

model Booking {
  id           String        @id @default(uuid())
  playerId     String
  stadiumId    String
  slotId       String        @unique
  status       BookingStatus @default(PENDING)
  createdAt    DateTime      @default(now())

  player       User          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  stadium      Stadium       @relation(fields: [stadiumId], references: [id], onDelete: Cascade)
  slot         Slot          @relation(fields: [slotId], references: [id], onDelete: Cascade)
  payment      Payment?
}

model Slot {
  id          String      @id @default(uuid())
  stadiumId   String
  location    String      @default("Main Location") // Which branch location this slot is for
  startTime   DateTime
  endTime     DateTime
  price       Float
  isBooked    Boolean     @default(false)
  createdAt   DateTime    @default(now())

  stadium     Stadium     @relation(fields: [stadiumId], references: [id], onDelete: Cascade)
  booking     Booking?
}

model Payment {
  id                  String        @id @default(uuid())
  bookingId           String        @unique
  amount              Float
  method              String        @default("CASH")
  status              PaymentStatus @default(PENDING)

  // Receipt submitted by player
  receiptImageUrl     String?       // Path to uploaded receipt image
  playerSubmittedAt   DateTime?     // When player submitted receipt

  // Owner review
  ownerConfirmedAt    DateTime?     // When owner confirmed payment
  ownerRejectedAt     DateTime?     // When owner rejected
  ownerRejectionReason String?      // Reason for rejection

  // Dispute
  isDisputed          Boolean       @default(false)
  disputeReason       String?
  disputedAt          DateTime?

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  booking             Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING           // No receipt uploaded yet
  RECEIPT_SUBMITTED // Player uploaded receipt, waiting for owner
  PAID              // Owner confirmed payment
  REJECTED          // Owner rejected receipt
  DISPUTED          // Player disputed rejection
}

model Review {
  id          String    @id @default(uuid())
  stadiumId   String
  playerId    String
  rating      Int       // 1-5 stars
  comment     String?
  ownerReply  String?   // Owner's response to the review
  repliedAt   DateTime? // When owner replied
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stadium     Stadium   @relation(fields: [stadiumId], references: [id], onDelete: Cascade)
  player      User      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([stadiumId, playerId]) // One review per player per stadium
  @@index([stadiumId])
  @@index([playerId])
}

model SubscriptionPlan {
  id          String    @id @default(uuid())
  stadiumId   String
  name        String    // e.g., "Monthly Pass", "Gold Membership"
  price       Float     // Price in ETB
  duration    Int       // Number of days (e.g., 30 for monthly)
  description String?   // Detailed benefits/features list
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stadium     Stadium   @relation(fields: [stadiumId], references: [id], onDelete: Cascade)
  playerSubscriptions PlayerSubscription[]

  @@index([stadiumId])
}

enum SubscriptionStatus {
  PENDING
  RECEIPT_SUBMITTED
  ACTIVE
  REJECTED
  EXPIRED
}

model PlayerSubscription {
  id                 String             @id @default(uuid())
  playerId           String
  subscriptionPlanId String
  status             SubscriptionStatus @default(PENDING)
  
  // Verification Code for Owner Check-in
  subscriptionCode   String             @unique // e.g. KS-XXXX-XXXX
  
  // Payment Tracking
  pricePaid          Float
  receiptImageUrl    String?            // Screenshot of bank transfer
  playerSubmittedAt  DateTime?
  
  // Approval / Rejection details
  ownerConfirmedAt   DateTime?
  ownerRejectedAt    DateTime?
  ownerRejectionReason String?
  
  // Subscription Active Period
  startDate          DateTime?
  endDate            DateTime?
  
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  player             User               @relation(fields: [playerId], references: [id], onDelete: Cascade)
  subscriptionPlan   SubscriptionPlan   @relation(fields: [subscriptionPlanId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([subscriptionPlanId])
  @@index([subscriptionCode])
}
